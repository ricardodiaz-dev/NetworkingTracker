# Copy to .env.local and fill in real values from the Neon Console.
# .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Public — inlined into the browser bundle by Next.js.
#
# Safe to expose, and that is the point of the design: these two URLs are the
# same ones the browser would discover anyway, and every row they can reach is
# gated by Row Level Security in Postgres. A leaked URL grants nothing without
# a valid JWT, and a valid JWT only ever reaches its own rows.
# ---------------------------------------------------------------------------

# Neon Console -> Auth -> Better Auth URL
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth

# Neon Console -> Data API -> Data API URL
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# ---------------------------------------------------------------------------
# Server-only — never prefixed with NEXT_PUBLIC_, never sent to the browser.
# ---------------------------------------------------------------------------

# Same value as NEXT_PUBLIC_NEON_DATA_API_URL. Kept as its own variable so the
# route handlers read a server-scoped name and never depend on a public one.
NEON_DATA_API_URL=https://ep-example-123456.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Pooled Postgres connection string, as the neondb_owner role.
# Used ONLY by `npm run db:push` and `npm run db:verify` — the application never
# opens a direct Postgres connection. This is the one true secret in this file:
# it bypasses RLS entirely. Never expose it to the browser, never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Note: there is deliberately no auth cookie secret here. Neon Managed Better Auth
# runs the auth service and owns its own signing keys, so the app never holds one.

# ---------------------------------------------------------------------------
# Local tooling — optional.
# ---------------------------------------------------------------------------

# Origin used by the scripts in scripts/. Better Auth rejects requests with no
# Origin header, and Neon only accepts origins allow-listed in the Console.
APP_URL=http://localhost:3000

# Only used by `npm run screenshots`, which drives your installed Chrome.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---------------------------------------------------------------------------
# Test fixtures — only needed for tests/rls.integration.test.ts, the two-account
# privacy proof. Without these, `npm test` skips that file automatically and the
# rest of the suite still runs.
#
# Create both accounts with `npm run test:users`. Use throwaway accounts: these
# are test fixtures, not real credentials.
# ---------------------------------------------------------------------------

TEST_USER_A_EMAIL=user-a@example.test
TEST_USER_A_PASSWORD=replace-with-a-throwaway-test-password
TEST_USER_B_EMAIL=user-b@example.test
TEST_USER_B_PASSWORD=replace-with-a-throwaway-test-password
