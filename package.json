    "db:push": "node --env-file-if-exists=.env.local scripts/apply-schema.mjs",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-security.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "test:users": "node --env-file-if-exists=.env.local scripts/ensure-test-users.mjs",
    "screenshots": "node --env-file-if-exists=.env.local scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.7.0-beta",
    "class-variance-authority": "^0.7.1",
